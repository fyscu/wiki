# Based on https://github.com/discourse/discourse_docker/blob/main/samples/standalone.yml
# Copy to /var/discourse/containers/app.yml and rebuild with ./launcher rebuild app.
templates:
  - templates/postgres.template.yml
  - templates/redis.template.yml
  - templates/web.template.yml
  - templates/web.ratelimited.template.yml

# Caddy terminates HTTPS and reaches this port via Docker's private bridge gateway.
expose:
  - "172.17.0.1:8080:80"

params:
  db_shared_buffers: "2048MB"

env:
  LC_ALL: en_US.UTF-8
  LANG: en_US.UTF-8
  LANGUAGE: en_US.UTF-8
  UNICORN_WORKERS: 4
  DISCOURSE_HOSTNAME: bbs.feiyang.ac.cn
  DISCOURSE_DEFAULT_LOCALE: zh_CN
  DISCOURSE_FORCE_HTTPS: "true"
  DISCOURSE_DEVELOPER_EMAILS: admin@example.com
  DISCOURSE_SOLVED_ENABLED: "true"

  DISCOURSE_SMTP_ADDRESS: smtp.example.com
  DISCOURSE_SMTP_PORT: 587
  DISCOURSE_SMTP_USER_NAME: forum@example.com
  DISCOURSE_SMTP_PASSWORD: "replace-with-smtp-password"
  DISCOURSE_NOTIFICATION_EMAIL: forum@example.com
  DISCOURSE_SMTP_ENABLE_START_TLS: "true"
  DISCOURSE_SMTP_FORCE_TLS: "false"
  # For implicit TLS on port 465, set FORCE_TLS to true and ENABLE_START_TLS to false.

volumes:
  - volume:
      host: /var/discourse/shared/standalone
      guest: /shared
  - volume:
      host: /var/discourse/shared/standalone/log/var-log
      guest: /var/log

hooks:
  after_code:
    - exec:
        cd: $home/plugins
        cmd:
          - git clone https://github.com/discourse/docker_manager.git
          # Discourse core ships Solved. The standalone repository is archived.

run:
  - file:
      path: /etc/nginx/conf.d/outlets/server/40-caddy-real-ip.conf
      chmod: 644
      contents: |
        set_real_ip_from 172.17.0.1;
        real_ip_header X-Forwarded-For;
