WIKI_DOMAIN=wiki.feiyang.ac.cn
BBS_DOMAIN=bbs.feiyang.ac.cn
# Optional address and port overrides for an internal deployment.
# CADDY_WIKI_ADDRESS=wiki.feiyang.ac.cn
# CADDY_BBS_ADDRESS=bbs.feiyang.ac.cn
# CADDY_BIND=0.0.0.0
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# BBS_UPSTREAM=host.docker.internal:8080
# WIKI_SITE_URL=https://wiki.feiyang.ac.cn/
# BBS_URL=https://bbs.feiyang.ac.cn/
GITHUB_REPO=fyscu/wiki
# Generate with openssl rand -hex 32, then use the same value in GitHub.
GITHUB_WEBHOOK_SECRET=
# Set to https://bbs.feiyang.ac.cn/ after configuring Embedding in Discourse.
DISCOURSE_URL=
