[
  {
    "id": "wiki-rebuild",
    "execute-command": "/usr/local/bin/build-wiki",
    "http-methods": ["POST"],
    "success-http-response-code": 202,
    "trigger-rule-mismatch-http-response-code": 403,
    "trigger-signature-soft-failures": true,
    "pass-arguments-to-command": [{"source": "header", "name": "X-GitHub-Event"}],
    "trigger-rule": {
      "and": [
        {"or": [{"match": {
          "type": "payload-hmac-sha256",
          "secret": {{ getenv "GITHUB_WEBHOOK_SECRET" | printf "%q" }},
          "parameter": {"source": "header", "name": "X-Hub-Signature-256"}
        }}]},
        {"match": {
          "type": "value",
          "value": {{ getenv "GITHUB_REPO" | printf "%q" }},
          "parameter": {"source": "payload", "name": "repository.full_name"}
        }},
        {"or": [
          {"match": {
            "type": "value",
            "value": "ping",
            "parameter": {"source": "header", "name": "X-GitHub-Event"}
          }},
          {"and": [
            {"match": {
              "type": "value",
              "value": "push",
              "parameter": {"source": "header", "name": "X-GitHub-Event"}
            }},
            {"match": {
              "type": "value",
              "value": "refs/heads/main",
              "parameter": {"source": "payload", "name": "ref"}
            }}
          ]}
        ]}
      ]
    }
  }
]
