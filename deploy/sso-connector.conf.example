# 统一登录 connector 白名单片段（放进 wiki 站 server{}，位于 `location /answer/ { return 404; }` 之前）
# 2026-11-13 新增。nginx `location =` 精确匹配优先于前缀匹配，因此下面三条会先于 404 生效。
# 仅放行 OAuth2 必需端点，其余 /answer/ 路径依旧 404；不暴露 /admin/。

limit_req_zone $binary_remote_addr zone=wiki_sso:1m rate=20r/m;

location = /answer/api/v1/connector/login/basic {
    limit_req zone=wiki_sso burst=8 nodelay;
    limit_req_status 429;
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://10.66.66.2:9080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
    add_header Cache-Control "no-store" always;
}

location = /answer/api/v1/connector/redirect/basic {
    limit_req zone=wiki_sso burst=8 nodelay;
    limit_req_status 429;
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://10.66.66.2:9080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    add_header Cache-Control "no-store" always;
}

location = /answer/api/v1/connector/info {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://10.66.66.2:9080;
    proxy_set_header Host $host;
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    add_header Cache-Control "no-store" always;
}

