[Unit]
Description=Feiyang Wiki content editor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=wiki-editor
Group=wiki-editor
WorkingDirectory=/opt/feiyang-wiki-editor/app
EnvironmentFile=/opt/feiyang-wiki-editor/editor.env
ExecStart=/opt/feiyang-wiki-editor/runtime/node-v24.16.0-linux-x64/bin/node editor/server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/feiyang-wiki-editor /opt/1panel/apps/openresty/openresty/www/sites/wiki.feiyang.ac.cn/content
MemoryMax=1G
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
