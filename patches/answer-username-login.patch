@@ -0,0 +1,69 @@
+package content
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/apache/answer/internal/entity"
+	usercommon "github.com/apache/answer/internal/service/user_common"
+	"github.com/stretchr/testify/require"
+)
+
+type loginLookupRepo struct {
+	usercommon.UserRepo
+	emailCalls []string
+	nameCalls  []string
+	names      map[string]*entity.User
+	emails     map[string]*entity.User
+	err        error
+}
+
+func (r *loginLookupRepo) GetByEmail(_ context.Context, value string) (*entity.User, bool, error) {
+	r.emailCalls = append(r.emailCalls, value)
+	user, found := r.emails[value]
+	return user, found, r.err
+}
+
+func (r *loginLookupRepo) GetByUsername(_ context.Context, value string) (*entity.User, bool, error) {
+	r.nameCalls = append(r.nameCalls, value)
+	user, found := r.names[value]
+	return user, found, r.err
+}
+
+func TestGetLoginUser(t *testing.T) {
+	account := &entity.User{ID: "42", Username: "whoami", EMail: "user@example.test"}
+	for _, input := range []string{"whoami", "WhoAmI", "  whoami  ", "user@example.test", " user@example.test "} {
+		t.Run(input, func(t *testing.T) {
+			repo := &loginLookupRepo{names: map[string]*entity.User{"whoami": account}, emails: map[string]*entity.User{account.EMail: account}}
+			user, found, err := (&UserService{userRepo: repo}).getLoginUser(context.Background(), input)
+			require.NoError(t, err)
+			require.True(t, found)
+			require.Equal(t, account.ID, user.ID)
+		})
+	}
+	t.Run("does not use a display name or cross from email to username", func(t *testing.T) {
+		repo := &loginLookupRepo{names: map[string]*entity.User{"whoami": account}}
+		_, found, err := (&UserService{userRepo: repo}).getLoginUser(context.Background(), "missing@example.test")
+		require.NoError(t, err)
+		require.False(t, found)
+		require.Empty(t, repo.nameCalls)
+		_, found, err = (&UserService{userRepo: repo}).getLoginUser(context.Background(), "显示名称")
+		require.NoError(t, err)
+		require.False(t, found)
+		require.Empty(t, repo.nameCalls)
+	})
+	t.Run("exact legacy username wins over lowercase fallback", func(t *testing.T) {
+		repo := &loginLookupRepo{names: map[string]*entity.User{"Legacy": account}}
+		_, found, err := (&UserService{userRepo: repo}).getLoginUser(context.Background(), "Legacy")
+		require.NoError(t, err)
+		require.True(t, found)
+		require.Equal(t, []string{"Legacy"}, repo.nameCalls)
+	})
+	t.Run("propagates database errors without another lookup", func(t *testing.T) {
+		repo := &loginLookupRepo{err: errors.New("database unavailable")}
+		_, _, err := (&UserService{userRepo: repo}).getLoginUser(context.Background(), "WhoAmI")
+		require.ErrorIs(t, err, repo.err)
+		require.Len(t, repo.nameCalls, 1)
+	})
+}
